{
  "name": "terminal-anki",
  "version": "2.1.0",
  "type": "module",
  "description": "Flashcards with spaced repetition in your terminal. SM-2 scheduling, two-keystroke grading, activity heatmap and undo, built on Ink and React.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "anki": "./dist/cli/main.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/cli/main.js",
    "dev": "tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/make-bin-executable.mjs",
    "watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run type-check && npm run format:check && npm run test",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "anki",
    "flashcards",
    "terminal",
    "cli",
    "spaced-repetition",
    "learning",
    "sm-2",
    "ink",
    "tui",
    "react",
    "study",
    "srs"
  ],
  "author": "dandrok",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dandrok/terminal-anki.git"
  },
  "bugs": {
    "url": "https://github.com/dandrok/terminal-anki/issues"
  },
  "homepage": "https://github.com/dandrok/terminal-anki#readme",
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "string-width": "^8.2.0",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run format:check",
    "pre-push": "npm run check && npm run build"
  }
}
